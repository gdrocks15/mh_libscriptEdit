///////////////////////////////////////////////////////////////////////////////
// NistWebBook Compound Data Import
// Formula and MolecularWeight are extracted from NIST WebBook JSON-LD metadata.
// AlternateNames are extracted from the NIST "Other names" field.
///////////////////////////////////////////////////////////////////////////////

//! <script>
//!  <language>CSharp</language>
//!  <reference>System.Drawing.dll</reference>
//!  <reference>System.Xml.dll</reference>
//!  <import>System</import>
//!  <import>System.Drawing</import>
//!  <import>System.Text</import>
//!  <import>System.IO</import>
//!  <import>System.Text.RegularExpressions</import>
//!  <import>System.Collections.Generic</import>
//!  <import>System.Net</import>
//!  <import>System.Windows.Forms</import>
//! </script>

int substanceCount = this.MainForm.CompoundGridPane.RowCount;

string message = "";
int timeOutMs = 50000;

this.ScriptProgress.Marquee = false;
this.ScriptProgress.ProgressStep = 1;
this.ScriptProgress.ProgressMaximum = substanceCount;

StringBuilder builder = new StringBuilder();

ServicePointManager.Expect100Continue = true;
ServicePointManager.DefaultConnectionLimit = 9999;
ServicePointManager.SecurityProtocol =
    SecurityProtocolType.Tls11 |
    SecurityProtocolType.Tls12 |
    SecurityProtocolType.Tls13;

Regex casRegex =
    new Regex(@"^[1-9]\d{1,5}-\d{2}-\d$");

for (int i = 0; i < substanceCount; i++)
{
    int compoundId =
        MainForm.CompoundGridPane.GetCompoundId(i);

    message =
        "Compound ID - " + compoundId;

    this.ScriptProgress.Message = message;
    this.ScriptProgress.ProgressValue = i + 1;

    try
    {
        string alternateNames = "";
        string formula = "";
        string molecularWeight = "";

        object existingAltNames =
            LibraryAccess.GetCompoundProperty(
                compoundId,
                "AlternateNames");

        object existingFormula =
            LibraryAccess.GetCompoundProperty(
                compoundId,
                "Formula");

        object existingMW =
            LibraryAccess.GetCompoundProperty(
                compoundId,
                "MolecularWeight");

        bool needAltNames =
            existingAltNames == null ||
            existingAltNames.ToString().Trim().Length == 0;

        bool needFormula =
            existingFormula == null ||
            existingFormula.ToString().Trim().Length == 0;

        bool needMW =
            existingMW == null ||
            existingMW.ToString().Trim().Length == 0;

        if (!needAltNames &&
            !needFormula &&
            !needMW)
        {
            builder.AppendLine(
                "Compound ID - " +
                compoundId +
                ": AlternateNames, Formula and MolecularWeight already populated.");

            continue;
        }

        object rawCas =
            LibraryAccess.GetCompoundProperty(
                compoundId,
                "CASNumber");

        string casNum =
            (rawCas != null)
                ? rawCas.ToString().Trim()
                : "";

        if (String.IsNullOrEmpty(casNum) ||
            !casRegex.IsMatch(casNum))
        {
            builder.AppendLine(
                "Compound ID - " +
                compoundId +
                ": Invalid CAS.");

            continue;
        }

        string cleanCasDigits =
            casNum.Replace("-", "");

        UriBuilder nistBuilder =
            new UriBuilder();

        nistBuilder.Scheme = "https";
        nistBuilder.Host = "webbook.nist.gov";
        nistBuilder.Path = "cgi/cbook.cgi";
        nistBuilder.Query =
            "ID=C" + cleanCasDigits;

        Uri finalNistUri =
            nistBuilder.Uri;

        builder.AppendLine(
            "Compound ID - " +
            compoundId +
            " | " +
            finalNistUri.AbsoluteUri);

        HttpWebRequest request =
            (HttpWebRequest)WebRequest.Create(finalNistUri);

        request.Timeout = timeOutMs;
        request.UserAgent =
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64)";
        request.Accept = "*/*";
        request.KeepAlive = false;
        request.Proxy = null;

        string html = "";

        using (HttpWebResponse response =
            (HttpWebResponse)request.GetResponse())
        using (Stream stream =
            response.GetResponseStream())
        using (StreamReader reader =
            new StreamReader(stream))
        {
            html = reader.ReadToEnd();
        }

        ///////////////////////////////////////////////////////////////////////
        // Formula (JSON-LD)
        ///////////////////////////////////////////////////////////////////////

        if (needFormula)
        {
            Match formulaMatch =
                Regex.Match(
                    html,
                    @"""molecularFormula""\s*:\s*""([^""]+)""",
                    RegexOptions.IgnoreCase);

            if (formulaMatch.Success)
            {
                formula =
                    formulaMatch.Groups[1].Value.Trim();
            }
        }

        ///////////////////////////////////////////////////////////////////////
        // Molecular Weight (JSON-LD)
        ///////////////////////////////////////////////////////////////////////

        if (needMW)
        {
            Match mwMatch =
                Regex.Match(
                    html,
                    @"""molecularWeight""\s*:\s*""([^""]+)""",
                    RegexOptions.IgnoreCase);

            if (mwMatch.Success)
            {
                molecularWeight =
                    mwMatch.Groups[1].Value;

                molecularWeight =
                    molecularWeight.Replace(
                        "amu",
                        "").Trim();
            }
        }

        ///////////////////////////////////////////////////////////////////////
        // Alternate Names
        ///////////////////////////////////////////////////////////////////////

        if (needAltNames)
        {
            int startPos =
                html.IndexOf(
                    "<li><strong>Other names:</strong>",
                    StringComparison.OrdinalIgnoreCase);

            if (startPos >= 0)
            {
                startPos +=
                    "<li><strong>Other names:</strong>".Length;

                int endPos =
                    html.IndexOf(
                        "</li>",
                        startPos,
                        StringComparison.OrdinalIgnoreCase);

                if (endPos > startPos)
                {
                    alternateNames =
                        html.Substring(
                            startPos,
                            endPos - startPos);

                    alternateNames =
                        Regex.Replace(
                            alternateNames,
                            @"\s+",
                            " ");

                    alternateNames =
                        alternateNames.Replace(
                            "\r",
                            " ");

                    alternateNames =
                        alternateNames.Replace(
                            "\n",
                            " ");

                    alternateNames =
                        WebUtility.HtmlDecode(
                            alternateNames);

                    alternateNames =
                        alternateNames.Trim();

                    string[] names =
                        alternateNames.Split(
                            new string[] { ";" },
                            StringSplitOptions.RemoveEmptyEntries);

                    List<string> topNames =
                        new List<string>();

                    for (int n = 0;
                         n < names.Length &&
                         n < 10;
                         n++)
                    {
                        topNames.Add(
                            names[n].Trim());
                    }

                    alternateNames =
                        String.Join(
                            "; ",
                            topNames.ToArray());
                }
            }
        }

        ///////////////////////////////////////////////////////////////////////
        // Update Library
        ///////////////////////////////////////////////////////////////////////

        List<Agilent.MassSpectrometry.DataAnalysis.LibraryEdit.Commands.CompoundProperty>
            properties =
                new List<Agilent.MassSpectrometry.DataAnalysis.LibraryEdit.Commands.CompoundProperty>();

        if (needAltNames &&
            !String.IsNullOrEmpty(alternateNames))
        {
            properties.Add(
                new Agilent.MassSpectrometry.DataAnalysis.LibraryEdit.Commands.CompoundProperty(
                    compoundId,
                    "AlternateNames",
                    alternateNames));
        }

        if (needFormula &&
            !String.IsNullOrEmpty(formula))
        {
            properties.Add(
                new Agilent.MassSpectrometry.DataAnalysis.LibraryEdit.Commands.CompoundProperty(
                    compoundId,
                    "Formula",
                    formula));
        }

        if (needMW &&
            !String.IsNullOrEmpty(molecularWeight))
        {
            properties.Add(
                new Agilent.MassSpectrometry.DataAnalysis.LibraryEdit.Commands.CompoundProperty(
                    compoundId,
                    "MolecularWeight",
                    molecularWeight));
        }

        if (properties.Count > 0)
        {
            SetCompoundProperty(
                properties.ToArray());

            builder.AppendLine(
                "Compound ID - " +
                compoundId +
                ": SUCCESS" +
                " | CAS=" + casNum +
                " | Formula=[" + formula + "]" +
                " | MW=[" + molecularWeight + "]" +
                " | AltNames=" +
                (String.IsNullOrEmpty(alternateNames)
                    ? "N/A"
                    : "FOUND"));
        }
        else
        {
            builder.AppendLine(
                "Compound ID - " +
                compoundId +
                ": No new data found.");
        }
    }
    catch (Exception ex)
    {
        builder.AppendLine(
            "Compound ID - " +
            compoundId +
            ": ERROR - " +
            ex.Message);
    }
}

Form summaryForm = new Form();

summaryForm.StartPosition =
    FormStartPosition.CenterParent;

summaryForm.MinimizeBox = false;
summaryForm.MaximizeBox = false;
summaryForm.ShowIcon = false;
summaryForm.ShowInTaskbar = false;

summaryForm.Text =
    "NIST Compound Data Import";

summaryForm.Size =
    new Size(900, 600);

TextBox textBox =
    new TextBox();

textBox.ReadOnly = true;
textBox.Dock = DockStyle.Fill;
textBox.Multiline = true;
textBox.WordWrap = false;
textBox.ScrollBars = ScrollBars.Both;
textBox.Text = builder.ToString();

textBox.Select(0, 0);

summaryForm.Controls.Add(textBox);

summaryForm.ShowDialog(MainForm);
